{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PinguinoLite",
  "version": "0.1.0",
  "identifier": "gg.pinguino.lite",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "PinguinoLite", "width": 1100, "height": 720, "minWidth": 860, "minHeight": 560, "visible": false }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
