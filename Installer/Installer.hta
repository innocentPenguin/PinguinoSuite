<!DOCTYPE html>
<html><head><meta http-equiv="x-ua-compatible" content="ie=edge"><title>PinguinoSuite Setup</title>
<HTA:APPLICATION ID="pi" APPLICATIONNAME="PinguinoSuite Setup" BORDER="thin" SCROLL="no" SINGLEINSTANCE="yes" MAXIMIZEBUTTON="no" />
<!-- INDEX Installer.hta: the PinguinoSuite Setup window (runs through mshta, built into Windows). Calls node install.mjs from the same payload; ES3 only (HTA engine). -->
<style>
body{margin:0;background:#17120f;color:#f3e9df;font:14px Segoe UI,Arial,sans-serif;padding:22px}
h1{margin:0 0 4px;color:#ff8a1f;font-size:22px} p.sub{margin:0 0 14px;color:#b9a898}
label{display:block;margin:10px 0 3px;color:#b9a898;font-size:12px}
input[type=text],input[type=password]{width:100%;box-sizing:border-box;background:#241c17;color:#f3e9df;border:1px solid #4a3a2e;padding:7px;font:13px Segoe UI}
.chk{margin:8px 0 0;color:#d8c9b8;font-size:13px}.chk input{vertical-align:middle}
button{margin-top:16px;background:#ff8a1f;color:#17120f;border:0;padding:9px 22px;font:bold 14px Segoe UI;cursor:pointer}
button[disabled]{background:#5a4630;color:#9a8a7a}
#bar{height:8px;background:#241c17;margin-top:16px;overflow:hidden;display:none;position:relative}#fill{height:8px;width:30%;background:#ff8a1f;position:absolute;left:0}
#log{margin-top:12px;font:12px Consolas,monospace;color:#d8c9b8;white-space:pre-wrap;min-height:90px;max-height:200px;overflow:auto}
.ok{color:#7ddc7d}.bad{color:#ff6a5a}
</style></head>
<body>
<h1>PinguinoSuite Setup</h1>
<p class="sub">Installs the Suite on this PC, adds anything it needs (.NET, Python, Node), and makes a Start-menu and Desktop shortcut. Nothing is uploaded and no keys are copied in.</p>
<label>Install into</label><input type="text" id="target">
<div id="keyrow" style="display:none"><label>Install passphrase (the one you chose when you sealed the key; lets this PC read updates from your private repo)</label><input type="password" id="pass"></div>
<div class="chk"><input type="checkbox" id="prereqs" checked> Install what is missing (.NET 8 runtime, Python, Node.js, Python packages). Needs internet; Windows may ask permission.</div>
<div class="chk"><input type="checkbox" id="short" checked> Make Start-menu and Desktop shortcuts</div>
<button id="go" onclick="run()">Install</button>
<div id="bar"><div id="fill"></div></div><div id="log"></div>
<script>
var sh=new ActiveXObject('WScript.Shell'),fso=new ActiveXObject('Scripting.FileSystemObject');
var REPO='innocentPenguin/PinguinoSuite';
var here=decodeURI(location.pathname.replace(/^\//,'')).split('/').join('\\');
var dir=here.substring(0,here.lastIndexOf('\\'));            // ...\Installer
var root=fso.GetParentFolderName(dir);                       // payload root (node.exe, release\)
var nodeExe=fso.FileExists(root+'\\node.exe')?root+'\\node.exe':'node';
var rel=root+'\\release', hasRel=fso.FileExists(rel+'\\manifest.json');
var hasKey=fso.FileExists(dir+'\\install.key.enc');
var logFile=fso.BuildPath(sh.ExpandEnvironmentStrings('%TEMP%'),'pinguino-setup.log');
var proc=null,seen=0,t=null,pos=0,finished=false;
document.getElementById('target').value=sh.ExpandEnvironmentStrings('%LOCALAPPDATA%')+'\\PinguinoSuite';
if(hasKey)document.getElementById('keyrow').style.display='block';
function v(i){return document.getElementById(i).value.replace(/^\s+|\s+$/g,'')}
function q(s){return '"'+s.replace(/"/g,'')+'"'}
function log(s,c){var l=document.getElementById('log');var sp=document.createElement('div');sp.className=c||'';sp.innerText=s;l.appendChild(sp);l.scrollTop=l.scrollHeight}
function run(){
 if(!hasRel&&!hasKey){log('This setup file has no bundled release and no key. Rebuild it with Installer\\Build-Installer.mjs.','bad');return}
 if(hasKey&&!hasRel&&v('pass').length<8){log('Type the install passphrase (8+ characters).','bad');return}
 var a=q(nodeExe)+' '+q(dir+'\\install.mjs')+' --progress --target '+q(v('target'));
 if(hasRel)a+=' --local '+q(rel);
 if(hasKey){a+=hasRel?' --update-from '+REPO:' --github '+REPO}
 if(document.getElementById('prereqs').checked)a+=' --prereqs';
 if(document.getElementById('short').checked)a+=' --shortcuts';
 if(hasKey&&v('pass'))sh.Environment('PROCESS')('PG_KEY_PASS')=v('pass');   // child process only; never on a command line
 document.getElementById('pass').value='';
 document.getElementById('go').disabled=true;document.getElementById('log').innerHTML='';document.getElementById('bar').style.display='block';
 try{fso.DeleteFile(logFile,true)}catch(e){}
 seen=0;finished=false;log('Installing...');
 proc=sh.Exec('cmd /c "'+a+' > '+q(logFile)+' 2>&1"');
 t=setInterval(tick,300);
}
function tick(){
 pos=(pos+7)%80;document.getElementById('fill').style.left=pos+'%';
 var txt='';try{var f=fso.OpenTextFile(logFile,1);if(!f.AtEndOfStream)txt=f.ReadAll();f.Close()}catch(e){}
 var lines=txt.split('\n');
 for(var i=seen;i<lines.length-1;i++){var ln=lines[i].replace(/\r/,'');if(!ln)continue;seen=i+1;handle(ln)}
 if(proc.Status==1&&!finished){
  var rest=lines[lines.length-1].replace(/\r/,'');if(rest&&rest.charAt(0)=='{'){handle(rest)}
  if(!finished)done({ok:false,message:'Setup stopped unexpectedly. Details are in '+logFile})
 }
}
function handle(ln){var o=null;try{o=eval('('+ln+')')}catch(e){if(ln.charAt(0)!='{')log(ln);return}
 if(o.progress){log('  '+o.progress)}else if(typeof o.ok!='undefined'){done(o)}}
function done(o){finished=true;clearInterval(t);document.getElementById('bar').style.display='none';document.getElementById('go').disabled=false;
 if(o.ok){
  log('Installed: '+(o.message||'done'),'ok');
  if(o.prereqs===false)log('Some prerequisites could not be installed. Run Setup again to retry; the Suite will tell you what is missing.','bad');
  if(o.keyStored)log('Update key stored on this PC (encrypted for this Windows user).');
  log('Next: open PinguinoSuite from the Desktop or Start menu. On the first run, import your settings: Settings > Backup & move > Import, and pick the export file from your main PC (it asks for its passphrase).','ok');
 }else{log('Failed: '+o.message,'bad');if(o.tried)for(var i=0;i<o.tried.length;i++)log('  '+o.tried[i])}
}
window.resizeTo(600,700);
</script></body></html>
