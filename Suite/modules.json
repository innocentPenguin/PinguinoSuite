[
  {
    "id": "listen",
    "name": "PinguinoListen",
    "desc": "Listens to your mic, transcribes, learns how you talk. Listen-only.",
    "cwd": "modules/listen",
    "cmd": [
      "{py}",
      "server.py"
    ],
    "port": 8765,
    "url": "http://127.0.0.1:8765",
    "health": "/api/status",
    "on_live": {
      "post": "/api/live/auto"
    },
    "on_offline": {
      "post": "/api/live/stop"
    },
    "defaults": {
      "enabled": true,
      "start_with_suite": true,
      "react_to_live": true
    },
    "ui": {
      "nav": "Listen",
      "icon": "🎙",
      "section": "Modules",
      "path": "/",
      "order": 10
    }
  },
  {
    "id": "multi",
    "name": "PinguinoMulti",
    "desc": "Unified streaming chat, explainable priority cards, reply tracking, multi-window layouts.",
    "cwd": "modules/multi",
    "cmd": [
      "{py}",
      "server.py"
    ],
    "port": 8766,
    "url": "http://127.0.0.1:8766",
    "health": "/api/status",
    "defaults": {
      "enabled": true,
      "start_with_suite": false
    },
    "ui": {
      "nav": "Multi",
      "icon": "🧊",
      "section": "Modules",
      "path": "/",
      "order": 20
    }
  },
  {
    "id": "host",
    "name": "PinguinoHost",
    "desc": "Runs the four Pinguino bots without Streamer.bot: Twitch chat, events, OBS, overlays. Setup page included.",
    "cwd": "../PinguinoHost",
    "cmd": [
      "dotnet",
      "bin/Release/net8.0/PinguinoHost.dll"
    ],
    "port": 8770,
    "url": "http://127.0.0.1:8770",
    "health": "/api/status",
    "defaults": {
      "enabled": true,
      "start_with_suite": false
    },
    "ui": {
      "nav": "Bots / Host",
      "icon": "🤖",
      "section": "Modules",
      "path": "/",
      "order": 30,
      "replaces": "bots"
    }
  }
]