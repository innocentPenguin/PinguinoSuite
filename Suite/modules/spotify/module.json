{
  "id": "spotify",
  "name": "PinguinoSpotify",
  "desc": "Spotify queue you own: drag-to-reorder, viewer song requests (!sr, !skip), fair ordering, stream-safe mode, OBS now-playing overlay.",
  "cmd": ["{py}", "server.py"],
  "cwd": "modules/spotify",
  "port": 8771,
  "url": "http://127.0.0.1:8771",
  "health": "/api/status",
  "prestream": "/api/prestream",
  "singleton": true,
  "singleton": true,
  "secrets": [{"name": "SPOTIFY_API_KEY", "label": "Spotify site API key (innocentpenguin.com)", "required": false, "test": "/api/test-key"}],
  "commands": ["sr", "skip", "song", "queue", "oops", "blocksong", "srclear"],
  "ui": { "nav": "Spotify", "icon": "🎵", "section": "Modules", "path": "/", "order": 50 },
  "defaults": { "enabled": true, "start_with_suite": true, "react_to_live": false }
}
