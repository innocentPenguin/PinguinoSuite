{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PinguinoSuite",
  "version": "0.1.0",
  "identifier": "gg.pinguino.suite",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "PinguinoSuite", "width": 1440, "height": 900, "minWidth": 960, "minHeight": 600, "visible": false }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; frame-src 'self' http://127.0.0.1:*; img-src 'self' data: https://i.scdn.co; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["binaries/*"]
  }
}
