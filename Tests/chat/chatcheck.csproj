<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles PinguinoChat\PinguinoChat.cs against a stub Streamer.bot and runs the checks in harness.cs. Use run-chat-tests.ps1. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>CS0168;CS0219;CS0414;CS0649;CS0169;SYSLIB0014;CS8981</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="stub.cs" /><Compile Include="harness.cs" /><Compile Include="build/chat.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
